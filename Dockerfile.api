# Runtime-only image: CI builds the jar and this just packages it.
# For a from-source build use Dockerfile.api.local.
FROM eclipse-temurin:17-jre
WORKDIR /app

RUN useradd --system --uid 10001 beardbuddy \
 && mkdir -p /var/log/beardbuddy \
 && chown -R beardbuddy:beardbuddy /var/log/beardbuddy
USER beardbuddy

# Produced by `mvn -pl core,api -am package`.
COPY api/target/beardbuddy-api.jar app.jar

EXPOSE 8080
ENTRYPOINT ["java", "-jar", "/app/app.jar"]
